# Development stays on this computer. Configure providers in OpenSI > Ulanishlar.
PORT=4580
HOST=127.0.0.1
APP_URL=http://127.0.0.1:4581
LOCAL_DEV_AUTH=true
DATA_DIR=./data
# Required for a public production host; 64 hex characters, generated locally.
OPENSI_ENCRYPTION_KEY=
VERCEL_INTEGRATION_CLIENT_ID=
VERCEL_INTEGRATION_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=
# Google credentials can also be entered in the local admin settings form.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
# Cloud shell uses Docker isolation and still needs per-command approval.
OPENSI_DOCKER_ENABLED=false
OPENSI_DOCKER_IMAGE=node:24-alpine
# API/model orchestration slots. Waiting for a user's reply does not occupy a slot.
OPENSI_MAX_CONCURRENT=100
OPENSI_MAX_CONCURRENT_PER_USER=3
# Match the execution broker capacity; this 4 GB VPS runs two sandboxes at a time.
OPENSI_MAX_CONCURRENT_SHELLS=2
